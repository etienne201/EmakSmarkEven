// ======================================================
// EMAK EVENT EXPERIENCE OPERATING SYSTEM
// ENTERPRISE SCALABLE ARCHITECTURE
// VERSION: 2.0
// ======================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ======================================================
// ENUMS
// ======================================================

enum UserStatus {
  active
  suspended
  blocked
}

enum EventStatus {
  draft
  review
  published
  completed
  archived
}

enum WorkflowStatus {
  draft
  review
  preview
  approved
  published
  archived
}

enum VisibilityType {
  public
  private
  vip
}

enum EventTypeKey {
  wedding
  birthday
  conference
  festival
  concert
  expo
  corporate
  networking
  church
  gala
  hybrid
  vip
  seminar
  other
}

enum AssetType {
  logo
  cover
  banner
  gallery
  document
  video
  audio
  template
  other
}

enum GuestStatus {
  pending
  confirmed
  declined
  checked_in
}

enum GuestType {
  individual
  couple
  family
  group
}

enum DesignStatus {
  draft
  final
}

enum DesignAssetCategory {
  shape
  sticker
  illustration
  icon
  decorative
}

enum DesignSourceType {
  upload
  template
  ai_generated
  blank
}

enum GuestRole {
  attendee
  vip
  speaker
  organizer
  staff
  exhibitor
}

enum TicketStatus {
  valid
  used
  cancelled
  expired
}

enum NotificationType {
  email
  sms
  push
  whatsapp
}

enum PermissionScope {
  global
  organization
  event
}

enum AccountType {
  INDIVIDUAL
  ORGANIZATION
}

// ======================================================
// ORGANIZATION
// ======================================================

model Organization {
  id      String  @id @default(uuid()) @db.Uuid
  name    String  @db.VarChar(150)
  slug    String  @unique @db.VarChar(150)
  logoUrl String? @map("logo_url")
  website String? @db.VarChar(255)
  phone   String? @db.VarChar(30)
  email   String? @db.VarChar(255)

  ownerId String @map("owner_id") @db.Uuid

  isActive Boolean @default(true) @map("is_active")

  brandPalette Json? @map("brand_palette")

  accountType AccountType @default(ORGANIZATION) @map("account_type")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner User @relation("OrganizationOwner", fields: [ownerId], references: [id])

  users     User[]
  events    Event[]
  templates Template[]
  assets    EventAsset[]
  speakers  Speaker[]
  venues    Venue[]
  apiKeys   ApiKey[]
  webhooks  Webhook[]

  @@map("organizations")
}

// ======================================================
// USERS & AUTH
// ======================================================

model User {
  id String @id @default(uuid()) @db.Uuid

  organizationId String? @map("organization_id") @db.Uuid

  roleId String @map("role_id") @db.Uuid

  email String @unique @db.VarChar(255)

  passwordHash String @map("password_hash")

  fullName String @map("full_name") @db.VarChar(150)

  roleOccupied String? @map("role_occupied") @db.VarChar(100)

  avatarUrl String? @map("avatar_url")

  phone String? @db.VarChar(30)

  status UserStatus @default(active)

  emailVerified Boolean @default(false) @map("email_verified")

  lastLoginAt DateTime? @map("last_login_at")

  accountType AccountType @default(INDIVIDUAL) @map("account_type")

  createdById String? @map("created_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  role Role @relation(fields: [roleId], references: [id])

  organization Organization? @relation(fields: [organizationId], references: [id])

  createdBy User? @relation("UserCreatedBy", fields: [createdById], references: [id])
  createdUsers User[] @relation("UserCreatedBy")

  ownedOrganizations Organization[] @relation("OrganizationOwner")

  sessions UserSession[]

  createdEvents Event[] @relation("CreatedBy")

  ownedEvents Event[] @relation("EventOwner")

  activityLogs ActivityLog[]

  uploads EventAsset[]

  notifications     Notification[]
  qrscans           QRScan[]
  securityAuditLogs SecurityAuditLog[]
  passwordResets    PasswordReset[]

  staffMembers Staff[] @relation("UserStaff")

  eventStaffAssignments EventStaff[] @relation("EventStaffUser")
  eventStaffCreated     EventStaff[] @relation("EventStaffAssignedBy")

  @@index([organizationId])
  @@index([roleId])
  @@map("users")
}

// ======================================================
// ROLE & PERMISSIONS
// ======================================================

model Role {
  id String @id @default(uuid()) @db.Uuid

  name String @unique @db.VarChar(100)

  description String?

  isSystem Boolean @default(false) @map("is_system")

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  permissions RolePermission[]

  users User[]

  eventStaff EventStaff[]

  @@map("roles")
}

model Permission {
  id String @id @default(uuid()) @db.Uuid

  key String @unique @db.VarChar(150)

  label String @db.VarChar(150)

  scope PermissionScope

  createdAt DateTime @default(now()) @map("created_at")

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId String @map("role_id") @db.Uuid

  permissionId String @map("permission_id") @db.Uuid

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ======================================================
// USER SESSION
// ======================================================

model UserSession {
  id String @id @default(uuid()) @db.Uuid

  userId String @map("user_id") @db.Uuid

  refreshToken String @unique @map("refresh_token")

  ipAddress String? @map("ip_address")

  userAgent String? @map("user_agent")

  expiresAt DateTime @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_sessions")
}

model PasswordReset {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  token     String   @unique
  expiresAt DateTime

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("password_resets")
}

// ======================================================
// EVENTS
// ======================================================

model Event {
  id String @id @default(uuid()) @db.Uuid

  organizationId String @map("organization_id") @db.Uuid

  createdById String @map("created_by_id") @db.Uuid

  title String @db.VarChar(255)

  slug String @unique @db.VarChar(255)

  description String?

  eventType EventTypeKey @map("event_type")

  visibility VisibilityType @default(private)

  language String @default("fr") @db.VarChar(10)

  timezone String? @db.VarChar(100)

  startDate DateTime @map("start_date")

  endDate DateTime? @map("end_date")

  coverImageUrl String? @map("cover_image_url")

  location String?

  city String? @db.VarChar(100)

  country String? @db.VarChar(100)

  status EventStatus @default(draft)

  setupCompleted Boolean @default(false) @map("setup_completed")

  currentStep Int @default(1) @map("current_step")

  metadata Json?

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  ownerId String @map("owner_id") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id])

  createdBy User @relation("CreatedBy", fields: [createdById], references: [id])

  owner User @relation("EventOwner", fields: [ownerId], references: [id])

  workflow EventWorkflow?

  settings EventSettings?

  analytics EventAnalytics?

  staffAssignments EventStaff[]

  modules EventModule[]

  guests Guest[]

  sessions EventSession[]

  themes EventTheme[]

  content EventContent?

  assets EventAsset[]

  templates EventTemplate[]

  notifications          Notification[]
  sponsors               Sponsor[]
  eventPublish           EventPublish?
  invitations            Invitation[]
  qrscans                QRScan[]
  dynamicForms           DynamicForm[]
  conversations          Conversation[]
  smartDesignGenerations SmartDesignGeneration[]

  activityLogs ActivityLog[]

  staff   Staff[]
  qrcodes QRCode[]
  designs Design[]

  @@index([organizationId])
  @@index([createdById])
  @@index([eventType])
  @@map("events")
}

// ======================================================
// EVENT MODULES
// ======================================================

model EventModule {
  id String @id @default(uuid()) @db.Uuid

  eventId String @map("event_id") @db.Uuid

  moduleKey String @map("module_key") @db.VarChar(100)

  enabled Boolean @default(true)

  config Json?

  version Int @default(1)

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, moduleKey])
  @@map("event_modules")
}

// ======================================================
// EVENT WORKFLOW
// ======================================================

model EventWorkflow {
  id String @id @default(uuid()) @db.Uuid

  eventId String @unique @map("event_id") @db.Uuid

  status WorkflowStatus @default(draft)

  currentStep String? @map("current_step")

  approvedById String? @map("approved_by_id") @db.Uuid

  publishedAt DateTime? @map("published_at")

  archivedAt DateTime? @map("archived_at")

  metadata Json?

  updatedAt DateTime @updatedAt @map("updated_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("event_workflows")
}

// ======================================================
// EVENT SETTINGS
// ======================================================

model EventSettings {
  id String @id @default(uuid()) @db.Uuid

  eventId String @unique @map("event_id") @db.Uuid

  rsvpEnabled Boolean @default(true) @map("rsvp_enabled")

  qrEnabled Boolean @default(true) @map("qr_enabled")

  checkinEnabled Boolean @default(true) @map("checkin_enabled")

  networkingEnabled Boolean @default(false) @map("networking_enabled")

  livestreamEnabled Boolean @default(false) @map("livestream_enabled")

  guestLimit Int? @map("guest_limit")

  customRules Json? @map("custom_rules")

  updatedAt DateTime @updatedAt @map("updated_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("event_settings")
}

// ======================================================
// EVENT THEME
// ======================================================

model EventTheme {
  id String @id @default(uuid()) @db.Uuid

  eventId String @map("event_id") @db.Uuid

  templateId String? @map("template_id") @db.Uuid

  name String @db.VarChar(150)

  tokens Json

  canvas Json?

  customCss String? @map("custom_css")

  version Int @default(1)

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  template Template? @relation(fields: [templateId], references: [id])

  sourceDesignId String? @map("source_design_id") @db.Uuid
  sourceDesign Design? @relation(fields: [sourceDesignId], references: [id])

  @@map("event_themes")
}

// ======================================================
// EVENT CONTENT
// ======================================================

model EventContent {
  id String @id @default(uuid()) @db.Uuid

  eventId String @unique @map("event_id") @db.Uuid

  locale String @db.VarChar(10)

  blocks Json

  variables Json?

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("event_contents")
}

// ======================================================
// EVENT SESSION
// ======================================================

model EventSession {
  id String @id @default(uuid()) @db.Uuid

  eventId String @map("event_id") @db.Uuid

  title String @db.VarChar(255)

  description String?

  venue String? @db.VarChar(255)

  startAt DateTime @map("start_at")

  endAt DateTime @map("end_at")

  capacity Int?

  metadata Json?

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  event           Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sessionSpeakers SessionSpeaker[]

  @@map("event_sessions")
}

// ======================================================
// GUESTS
// ======================================================

model Guest {
  id String @id @default(uuid()) @db.Uuid

  eventId String @map("event_id") @db.Uuid

  fullName String @map("full_name") @db.VarChar(150)

  email String? @db.VarChar(255)

  phone String? @db.VarChar(30)

  guestRole GuestRole @default(attendee) @map("guest_role")

  status GuestStatus @default(pending)

  guestType GuestType @default(individual) @map("guest_type")

  qrCode String? @map("qr_code")

  invitationUrl String? @map("invitation_url")

  ticketId String? @map("ticket_id") @db.Uuid

  metadata Json?

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  ticket GuestTicket?

  checkins                 GuestCheckin[]
  invitations              Invitation[]
  qrscans                  QRScan[]
  formResponses            FormResponse[]
  conversationParticipants ConversationParticipant[]
  conversationMessages     ConversationMessage[]
  qrcodes                  QRCode[]

  @@index([eventId])
  @@map("guests")
}

// ======================================================
// GUEST TICKETS
// ======================================================

model GuestTicket {
  id String @id @default(uuid()) @db.Uuid

  guestId String @unique @map("guest_id") @db.Uuid

  code String @unique @db.VarChar(100)

  ticketType String @map("ticket_type") @db.VarChar(100)

  status TicketStatus @default(valid)

  issuedAt DateTime @default(now()) @map("issued_at")

  expiresAt DateTime? @map("expires_at")

  guest Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@map("guest_tickets")
}

// ======================================================
// GUEST CHECKIN
// ======================================================

model GuestCheckin {
  id String @id @default(uuid()) @db.Uuid

  guestId String @map("guest_id") @db.Uuid

  scannedAt DateTime @default(now()) @map("scanned_at")

  location String? @db.VarChar(255)

  device String? @db.VarChar(255)

  metadata Json?

  guest Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@map("guest_checkins")
}

// ======================================================
// TEMPLATES
// ======================================================

model Template {
  id String @id @default(uuid()) @db.Uuid

  organizationId String? @map("organization_id") @db.Uuid

  name String @db.VarChar(150)

  category String @db.VarChar(100)

  previewUrl String @map("preview_url")

  config Json

  isPremium Boolean @default(false) @map("is_premium")

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization? @relation(fields: [organizationId], references: [id])

  themes EventTheme[]

  eventTemplates EventTemplate[]
  invitations    Invitation[]

  @@map("templates")
}

// ======================================================
// EVENT TEMPLATE
// ======================================================

model EventTemplate {
  eventId String @map("event_id") @db.Uuid

  templateId String @map("template_id") @db.Uuid

  assignedAt DateTime @default(now()) @map("assigned_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@id([eventId, templateId])
  @@map("event_templates")
}

// ======================================================
// EVENT ASSETS
// ======================================================

model EventAsset {
  id String @id @default(uuid()) @db.Uuid

  organizationId String? @map("organization_id") @db.Uuid

  eventId String? @map("event_id") @db.Uuid

  uploadedById String @map("uploaded_by_id") @db.Uuid

  assetType AssetType @map("asset_type")

  url String

  fileName String @map("file_name")

  mimeType String? @map("mime_type")

  sizeBytes Int? @map("size_bytes")

  metadata Json?

  createdAt DateTime @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id])

  event Event? @relation(fields: [eventId], references: [id])

  uploadedBy User @relation(fields: [uploadedById], references: [id])

  designsUsingAsBackground Design[] @relation("DesignBackgroundAsset")

  @@map("event_assets")
}

// ======================================================
// ANALYTICS
// ======================================================

model EventAnalytics {
  id String @id @default(uuid()) @db.Uuid

  eventId String @unique @map("event_id") @db.Uuid

  totalViews Int @default(0)

  totalScans Int @default(0)

  totalGuests Int @default(0)

  totalCheckins Int @default(0)

  totalConfirmed Int @default(0)

  engagementScore Float @default(0)

  metadata Json?

  updatedAt DateTime @updatedAt @map("updated_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("event_analytics")
}

// ======================================================
// NOTIFICATIONS
// ======================================================

model Notification {
  id String @id @default(uuid()) @db.Uuid

  userId String? @map("user_id") @db.Uuid

  eventId String? @map("event_id") @db.Uuid

  type NotificationType

  title String @db.VarChar(255)

  content String

  sentAt DateTime?

  metadata Json?

  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  event Event? @relation(fields: [eventId], references: [id])

  @@map("notifications")
}

// ======================================================
// ACTIVITY LOGS
// ======================================================

model ActivityLog {
  id String @id @default(uuid()) @db.Uuid

  userId String? @map("user_id") @db.Uuid

  action String @db.VarChar(150)

  targetType String? @map("target_type")

  targetId String? @map("target_id")

  details Json?

  ipAddress String? @map("ip_address")

  userAgent String? @map("user_agent")

  eventId String? @map("event_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  user  User?  @relation(fields: [userId], references: [id])
  event Event? @relation(fields: [eventId], references: [id])

  @@index([eventId])
  @@map("activity_logs")
}

// ======================================================
// SPEAKERS
// ======================================================

model Speaker {
  id String @id @default(uuid()) @db.Uuid

  organizationId String? @map("organization_id") @db.Uuid

  fullName String @map("full_name") @db.VarChar(150)

  title String? @db.VarChar(150)

  bio String?

  avatarUrl String? @map("avatar_url")

  email String? @db.VarChar(255)

  phone String? @db.VarChar(30)

  socialLinks Json? @map("social_links")

  metadata Json?

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  sessions SessionSpeaker[]

  organization Organization? @relation(fields: [organizationId], references: [id])

  @@map("speakers")
}

// ======================================================
// SESSION SPEAKERS
// ======================================================

model SessionSpeaker {
  sessionId String @map("session_id") @db.Uuid

  speakerId String @map("speaker_id") @db.Uuid

  role String? @db.VarChar(100)

  createdAt DateTime @default(now()) @map("created_at")

  session EventSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  speaker Speaker @relation(fields: [speakerId], references: [id], onDelete: Cascade)

  @@id([sessionId, speakerId])
  @@map("session_speakers")
}

// ======================================================
// SPONSORS
// ======================================================

model Sponsor {
  id String @id @default(uuid()) @db.Uuid

  eventId String @map("event_id") @db.Uuid

  companyName String @map("company_name") @db.VarChar(150)

  logoUrl String? @map("logo_url")

  website String? @db.VarChar(255)

  contactEmail String? @map("contact_email") @db.VarChar(255)

  sponsorshipTier String? @map("sponsorship_tier") @db.VarChar(100)

  metadata Json?

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("sponsors")
}

// ======================================================
// EVENT VENUES
// ======================================================

model Venue {
  id String @id @default(uuid()) @db.Uuid

  organizationId String? @map("organization_id") @db.Uuid

  name String @db.VarChar(150)

  address String?

  city String? @db.VarChar(100)

  country String? @db.VarChar(100)

  latitude Float?

  longitude Float?

  capacity Int?

  mapUrl String? @map("map_url")

  metadata Json?

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization? @relation(fields: [organizationId], references: [id])

  @@map("venues")
}

// ======================================================
// EVENT PUBLISHING
// ======================================================

model EventPublish {
  id String @id @default(uuid()) @db.Uuid

  eventId String @unique @map("event_id") @db.Uuid

  publicUrl String? @map("public_url")

  shortUrl String? @map("short_url")

  seoTitle String? @map("seo_title")

  seoDescription String? @map("seo_description")

  seoImage String? @map("seo_image")

  customDomain String? @map("custom_domain")

  publishedAt DateTime? @map("published_at")

  unpublishedAt DateTime? @map("unpublished_at")

  metadata Json?

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("event_publishes")
}

// ======================================================
// INVITATION SYSTEM
// ======================================================

model Invitation {
  id String @id @default(uuid()) @db.Uuid

  eventId String @map("event_id") @db.Uuid

  guestId String? @map("guest_id") @db.Uuid

  templateId String? @map("template_id") @db.Uuid

  invitationCode String @unique @map("invitation_code")

  invitationUrl String? @map("invitation_url")

  qrCodeUrl String? @map("qr_code_url")

  sent Boolean @default(false)

  sentAt DateTime? @map("sent_at")

  viewedAt DateTime? @map("viewed_at")

  metadata Json?

  createdAt DateTime @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  guest Guest? @relation(fields: [guestId], references: [id], onDelete: Cascade)

  template Template? @relation(fields: [templateId], references: [id])

  @@map("invitations")
}

// ======================================================
// QR SCANS
// ======================================================

model QRScan {
  id String @id @default(uuid()) @db.Uuid

  eventId String @map("event_id") @db.Uuid

  guestId String? @map("guest_id") @db.Uuid

  scannedById String? @map("scanned_by_id") @db.Uuid

  scanType String @map("scan_type") @db.VarChar(100)

  deviceInfo String? @map("device_info")

  ipAddress String? @map("ip_address")

  location String?

  metadata Json?

  scannedAt DateTime @default(now()) @map("scanned_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  guest Guest? @relation(fields: [guestId], references: [id])

  scannedBy User? @relation(fields: [scannedById], references: [id])

  @@map("qr_scans")
}

// ======================================================
// DYNAMIC FORM ENGINE
// ======================================================

model DynamicForm {
  id String @id @default(uuid()) @db.Uuid

  eventId String @map("event_id") @db.Uuid

  name String @db.VarChar(150)

  slug String @unique @db.VarChar(150)

  description String?

  schema Json

  settings Json?

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  responses FormResponse[]

  @@map("dynamic_forms")
}

// ======================================================
// FORM RESPONSES
// ======================================================

model FormResponse {
  id String @id @default(uuid()) @db.Uuid

  formId String @map("form_id") @db.Uuid

  guestId String? @map("guest_id") @db.Uuid

  answers Json

  submittedAt DateTime @default(now()) @map("submitted_at")

  form DynamicForm @relation(fields: [formId], references: [id], onDelete: Cascade)

  guest Guest? @relation(fields: [guestId], references: [id])

  @@map("form_responses")
}

// ======================================================
// REALTIME CHAT / NETWORKING
// ======================================================

model Conversation {
  id String @id @default(uuid()) @db.Uuid

  eventId String @map("event_id") @db.Uuid

  title String? @db.VarChar(150)

  isGroup Boolean @default(false) @map("is_group")

  metadata Json?

  createdAt DateTime @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  participants ConversationParticipant[]

  messages ConversationMessage[]

  @@map("conversations")
}

model ConversationParticipant {
  conversationId String @map("conversation_id") @db.Uuid

  guestId String @map("guest_id") @db.Uuid

  joinedAt DateTime @default(now()) @map("joined_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  guest Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@id([conversationId, guestId])
  @@map("conversation_participants")
}

model ConversationMessage {
  id String @id @default(uuid()) @db.Uuid

  conversationId String @map("conversation_id") @db.Uuid

  senderGuestId String? @map("sender_guest_id") @db.Uuid

  content String

  attachments Json?

  createdAt DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderGuest Guest? @relation(fields: [senderGuestId], references: [id])

  @@map("conversation_messages")
}

// ======================================================
// AI SMART DESIGN ENGINE
// ======================================================

model SmartDesignGeneration {
  id String @id @default(uuid()) @db.Uuid

  eventId String @map("event_id") @db.Uuid

  prompt String

  generatedTheme Json @map("generated_theme")

  generatedLayout Json @map("generated_layout")

  aiProvider String? @map("ai_provider")

  version Int @default(1)

  createdAt DateTime @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("smart_design_generations")
}

// ======================================================
// AUDIT SECURITY LOGS
// ======================================================

model SecurityAuditLog {
  id String @id @default(uuid()) @db.Uuid

  userId String? @map("user_id") @db.Uuid

  action String @db.VarChar(150)

  severity String @db.VarChar(50)

  ipAddress String? @map("ip_address")

  userAgent String? @map("user_agent")

  metadata Json?

  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@map("security_audit_logs")
}

// ======================================================
// API KEYS
// ======================================================

model ApiKey {
  id String @id @default(uuid()) @db.Uuid

  organizationId String @map("organization_id") @db.Uuid

  name String @db.VarChar(150)

  keyHash String @map("key_hash")

  scopes Json?

  lastUsedAt DateTime? @map("last_used_at")

  expiresAt DateTime? @map("expires_at")

  revokedAt DateTime? @map("revoked_at")

  createdAt DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("api_keys")
}

// ======================================================
// WEBHOOKS
// ======================================================

model Webhook {
  id String @id @default(uuid()) @db.Uuid

  organizationId String @map("organization_id") @db.Uuid

  endpoint String

  secret String

  events Json

  active Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("webhooks")
}

// ======================================================
// PLATFORM SETTINGS
// ======================================================

model PlatformSetting {
  id    String @id @default(uuid()) @db.Uuid
  key   String @unique @db.VarChar(100)
  value String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}

// ======================================================
// EVENT STAFF & QR CODES
// ======================================================

model Staff {
  id String @id @default(uuid()) @db.Uuid

  eventId String @map("event_id") @db.Uuid

  userId String? @map("user_id") @db.Uuid

  fullName String @map("full_name") @db.VarChar(150)

  email String @db.VarChar(255)

  phone String? @db.VarChar(30)

  role String @db.VarChar(50)

  status String @default("active") @db.VarChar(50)

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  user User? @relation("UserStaff", fields: [userId], references: [id], onDelete: SetNull)

  qrcodes QRCode[]

  @@index([eventId])
  @@index([userId])
  @@map("event_staff")
}

model EventStaff {
  id           String   @id @default(uuid()) @db.Uuid
  eventId      String   @map("event_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  assignedById String   @map("assigned_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  event      Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user       User  @relation("EventStaffUser", fields: [userId], references: [id], onDelete: Cascade)
  role       Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedBy User  @relation("EventStaffAssignedBy", fields: [assignedById], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
  @@index([roleId])
  @@index([assignedById])
  @@map("event_staff_pivot")
}

model QRCode {
  id String @id @default(uuid()) @db.Uuid

  eventId String @map("event_id") @db.Uuid

  code String @unique @db.VarChar(100)

  guestId String? @map("guest_id") @db.Uuid

  staffId String? @map("staff_id") @db.Uuid

  status String @default("active") @db.VarChar(50)

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  guest Guest? @relation(fields: [guestId], references: [id], onDelete: Cascade)

  staff Staff? @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([guestId])
  @@index([staffId])
  @@map("event_qrcodes")
}

// ======================================================
// DESIGN STUDIO MODELS
// ======================================================

model Design {
  id String @id @default(uuid()) @db.Uuid

  eventId String @map("event_id") @db.Uuid

  name String @default("Sans titre") @db.VarChar(150)

  sourceType DesignSourceType @default(blank) @map("source_type")

  canvasWidth  Int @default(1080) @map("canvas_width")
  canvasHeight Int @default(1440) @map("canvas_height")

  layersData Json @map("layers_data")

  colorPalette Json? @map("color_palette")

  backgroundAssetId String? @map("background_asset_id") @db.Uuid

  baseTemplateId String? @map("base_template_id") @db.Uuid

  aiPrompt String? @map("ai_prompt")

  version Int @default(1)

  status DesignStatus @default(draft)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  event           Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  baseTemplate    DesignTemplate? @relation(fields: [baseTemplateId], references: [id])
  backgroundAsset EventAsset?     @relation("DesignBackgroundAsset", fields: [backgroundAssetId], references: [id])

  exports     DesignExport[]
  history     DesignVersion[]
  eventThemes EventTheme[]

  @@index([eventId])
  @@map("designs")
}

model DesignVersion {
  id String @id @default(uuid()) @db.Uuid

  designId String @map("design_id") @db.Uuid

  layersData Json @map("layers_data")

  version Int

  createdAt DateTime @default(now()) @map("created_at")

  design Design @relation(fields: [designId], references: [id], onDelete: Cascade)

  @@index([designId])
  @@map("design_versions")
}

model DesignExport {
  id String @id @default(uuid()) @db.Uuid

  designId String @map("design_id") @db.Uuid

  format String @db.VarChar(10)

  url String

  width  Int?
  height Int?

  createdAt DateTime @default(now()) @map("created_at")

  design Design @relation(fields: [designId], references: [id], onDelete: Cascade)

  @@map("design_exports")
}

model DesignTemplate {
  id String @id @default(uuid()) @db.Uuid

  name String @db.VarChar(150)

  eventType EventTypeKey? @map("event_type")

  style String? @db.VarChar(100)

  previewUrl String @map("preview_url")

  layersData Json @map("layers_data")

  isPremium Boolean @default(false) @map("is_premium")

  createdAt DateTime @default(now()) @map("created_at")

  designs Design[]

  @@index([eventType])
  @@map("design_templates")
}

model DesignAsset {
  id String @id @default(uuid()) @db.Uuid

  category DesignAssetCategory

  name String @db.VarChar(150)

  url String

  tags Json?

  isPremium Boolean @default(false) @map("is_premium")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([category])
  @@map("design_assets")
}
