{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "baseUrl": ".",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@/backend/*": ["./backend/src/*"],
      "@backend/*": ["./backend/src/*"],
      "@frontend/components/*": ["./packages/ui/src/components/*"],
      "@frontend/hooks/*": ["./packages/shared/src/hooks/*"],
      "@frontend/lib/*": ["./packages/shared/src/lib/*"],
      "@frontend/*": ["./packages/shared/src/*"],
      "@qa/*": ["./qa/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    ".next-*",
    ".next-admin",
    ".next-api",
    ".next-user",
    ".turbo",
    "backend",
    "build",
    "dist",
    "infrastructure",
    "qa",
    "apps/backend",
    "apps/admin-web/backend",
    "apps/admin-web/app/api",
    "apps/admin-web/app/api-docs"
  ]
}
