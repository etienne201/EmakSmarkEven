{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@backend/*": ["./src/backend/src/*"],
      "@frontend/*": ["./src/frontend/src/*"],
      "@qa/*": ["./qa/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-*/types/**/*.ts",
    ".next-*/dev/types/**/*.ts",
    ".next-api/types/**/*.ts",
    ".next-api/dev/types/**/*.ts",
    ".next-admin/types/**/*.ts",
    ".next-admin/dev/types/**/*.ts",
    ".next-user/types/**/*.ts",
    ".next-user/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
