{
  "extends": "./base.json",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "noEmit": true,
    "incremental": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "paths": {
      "@frontend/components/*": ["../../packages/ui/src/components/*"],
      "@frontend/hooks/*": ["../../packages/shared/src/hooks/*"],
      "@frontend/lib/*": ["../../packages/shared/src/lib/*"],
      "@frontend/*": ["../../packages/shared/src/*"],
      "@backend/*": ["../../backend/src/*"],
      "@/backend/*": ["../../backend/src/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  }
}
