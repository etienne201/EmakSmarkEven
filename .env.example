# SMART EVENT AI OS - ENVIRONMENT TEMPLATE
# Copy this file to .env and fill in the values

# 🔐 SECURITY
JWT_SECRET=your_jwt_secret_here

# 🔥 FIREBASE (Client SDK)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# 🛡️ FIREBASE ADMIN SDK
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# 📦 STORAGE (Empty values = Local Storage Fallback)
KV_REST_API_URL=
KV_REST_API_TOKEN=
REDIS_URL=

# 🌐 NETWORK
NEXT_PUBLIC_API_URL=http://localhost:3001
PORT=3001
SERVICE_MODE=api
# Comma-separated frontend origins allowed by the NestJS API (CORS)
CORS_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:3003,http://localhost:3004,http://localhost:3005

# 📧 SMTP (invitations admin)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Smart Event" <noreply@smartevent.com>

# 🛠️ SYSTEM
NODE_ENV=development

# 👤 Default demo accounts (after `pnpm run seed` in backend/)
# Super Admin : superadmin@smartevent.com / Superadmin123@
# Organisateur: UserEven / User123@
